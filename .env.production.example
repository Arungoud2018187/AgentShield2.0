# ==============================================================================
# AgentShield Production Environment Configuration (Template)
# Copy this file to .env and replace placeholders with real secrets
# ==============================================================================

# Port to expose on the host (Port 80 is standard HTTP, or use 3000 / 8080)
FRONTEND_PORT=80

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_PASSWORD_ENCODED=your_secure_postgres_password_url_encoded
POSTGRES_DB=agentshield

# JWT Secret Key (Generate a random 64-char key in production)
SECRET_KEY=generate_a_random_secure_jwt_secret_key_here

# OpenRouter AI Engine Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/free
